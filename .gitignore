# Python bytecode
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
dist/
build/
*.egg-info/

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Honeypot runtime artifacts
*.jsonl
.ssh_host_key

# Ansible secrets and fetched collections
.vault_pass
!.vault_pass.example
.collections/
*.retry

# Vagrant runtime state (.vagrant/machines/*/private_key is a real SSH key)
.vagrant/

