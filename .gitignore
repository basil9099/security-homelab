packer_cache/
output-*/
*.box
*.vmdk
*.vhd
*.vhdx
*.iso

# Unsanitised device exports — pfSense backups download as config-<host>-<date>.xml.
# The committed, sanitised config.xml is deliberately not matched by this.
projects/defensive/pfsense_firewall/config/config-*.xml
projects/defensive/pfsense_firewall/config/exported-config.xml
