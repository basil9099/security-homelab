# Python bytecode
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
dist/
build/
*.egg-info/

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Honeypot runtime artifacts
*.jsonl
.ssh_host_key

# network_anomaly_ml runtime artifacts (models, demo output, synthetic CSVs)
projects/defensive/network_anomaly_ml/data/*
!projects/defensive/network_anomaly_ml/data/.gitkeep


