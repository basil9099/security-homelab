index=wineventlog (source="XmlWinEventLog:Security" OR sourcetype="XmlWinEventLog:Security") EventCode=4769 TicketEncryptionType="0x17" TicketOptions="0x40810000" Status="0x0"
| where NOT match(ServiceName, "\$$") AND ServiceName!="krbtgt"
| bucket _time span=10m
| stats dc(ServiceName) AS services_requested,
        values(ServiceName) AS services
        BY _time, TargetUserName, IpAddress
| where services_requested >= 5
