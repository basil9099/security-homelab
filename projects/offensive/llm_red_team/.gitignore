# Runtime artifacts.

# Scan output: reports, garak option files, per-family .report.jsonl.
runs/

# garak writes these next to wherever it is invoked from.
garak.log
*.hitlog.jsonl

# The root .gitignore ignores *.jsonl repo-wide (honeypot runtime artifacts).
# The parsed-report fixtures are source, not runtime output, and the test suite
# does not run without them — re-include them here.
!tests/fixtures/*.report.jsonl
